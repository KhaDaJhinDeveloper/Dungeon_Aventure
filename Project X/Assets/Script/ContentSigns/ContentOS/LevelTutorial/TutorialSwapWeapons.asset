  m_Name: TutorialSwapWeapons
  m_EditorClassIdentifier: 
  spriteDescription: {fileID: 21300000, guid: 45b22a13a5f27934eaded99ff2c9edae, type: 3}
  textDescription: 'When you pick up a new weapon and have 2 weapons, click on the
    weapon position you want to change, the new weapon you picked up will replace
    the old weapon.

    Once you have 2 weapons, press the left Ctrl key to show
    the current weapon interface.

    You can press X to switch weapon positions.


'
